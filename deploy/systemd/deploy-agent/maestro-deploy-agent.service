# Maestro host-local pull-based deploy agent — oneshot service.
#
# Installed out-of-band onto the production host (see deploy/systemd/README.md).
# UNLIKE the sibling <unit>.d/ resource drop-ins, this is a full executable unit,
# not a [Service] merge over a vendored base — so it carries [Unit]/[Service]/
# [Install] sections of its own and lives in a non-`.d` subdirectory.
#
# The values below match docs/vps-setup.md: the maestro user's checkout at
# /home/maestro/maestro. Operator: adjust User=, WorkingDirectory=, and ExecStart=
# if your deploy user or repo-clone path differ. The script defaults its deploy
# directory to ${DEPLOY_DIR:-$HOME/maestro}; set Environment=DEPLOY_DIR=/path/to/clone
# here if the clone lives elsewhere than the service user's $HOME/maestro.
# User=maestro runs the agent from the agent-writable checkout, which is not
# hardened (see the Known limitation in docs/vps-setup.md); a hardened setup
# sets User= to a separate deploy user that owns its own clone.

[Unit]
Description=Maestro host-local pull-based deploy agent
Documentation=file:///home/maestro/maestro/deploy/systemd/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=maestro
WorkingDirectory=/home/maestro/maestro
ExecStart=/home/maestro/maestro/scripts/deploy-agent.sh

[Install]
WantedBy=multi-user.target
