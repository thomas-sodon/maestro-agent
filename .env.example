# Maestro Environment Configuration — Secrets Only
# Copy this file to .env and fill in your values.
# SECURITY: Set file permissions to owner-only:  chmod 600 .env
#
# All non-secret configuration (paths, repo, verbose, dashboard port/host,
# chat_id) has moved to maestro.toml with per-environment overrides.
# See maestro.toml and maestro.production.toml for details.

# ── Authentication (one of these is required) ──────────────────────
#
# Option 1: API key from console.anthropic.com (pay-per-token)
# ANTHROPIC_API_KEY=sk-ant-api03-...
#
# Option 2: OAuth token from Claude Max/Pro subscription (personal use only)
# Generate with: npm install -g @anthropic-ai/claude-code && claude setup-token
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# ── Environment overlay ──────────────────────────────────────────────
#
# Selects which TOML config overlay to load (e.g. maestro.production.toml).
# MAESTRO_ENV=production

# ── GitHub ────────────────────────────────────────────────────────────
#
# GitHub personal access token for pushing branches and creating PRs.
# Fine-grained PAT minimum scopes: contents:write, pull_requests:write, issues:write
# GITHUB_TOKEN=github_pat_...

# ── Telegram ──────────────────────────────────────────────────────────
#
# Telegram bot token and chat ID for notifications.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Dashboard ─────────────────────────────────────────────────────────
#
# Authentication token for dashboard API (port/host are now in maestro.toml).
# MAESTRO_DASHBOARD_TOKEN=

# ── Docker / Git identity ──────────────────────────────────────────
#
# Git author info for commits made inside the container.
# GIT_AUTHOR_NAME=Maestro
# GIT_AUTHOR_EMAIL=maestro@example.com
# GIT_COMMITTER_NAME=Maestro
# GIT_COMMITTER_EMAIL=maestro@example.com

# ── Backup ─────────────────────────────────────────────────────────
#
# Hetzner Storage Box for off-server backup (optional).
# Format: u12345@u12345.your-storagebox.de
# HETZNER_STORAGE_BOX=
